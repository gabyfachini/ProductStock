## -----------------------------------------------
## .gitignore for C# / .NET / Visual Studio project
## -----------------------------------------------

# Build output folders
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# NuGet packages (restored automatically)
packages/
*.nupkg
project.lock.json
project.assets.json

# Rider IDE
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Log and temp files
*.log
*.tmp
*.cache

# Publish output
publish/
**/publish/

# Test results
TestResults/
coverage/
*.trx
*.coveragexml